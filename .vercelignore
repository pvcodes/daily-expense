# Local-only files that must never be uploaded to Vercel.
# The Vercel CLI does NOT honour .gitignore, so they are listed explicitly here.

# Secrets and personal data
.env
.env.*
!.env.example
exported_transactions.csv

# Local database dumps
backups/

# Local agent/tool state and session logs
codex-session-*.md
.dual-graph/
.dual-graph-context/
.agents/
skills-lock.json
opencode.json
CODEX.md
CLAUDE.md
AGENTS.md

# Documentation and one-time design input (not needed to build or run)
README.md
MIGRATION.md
schema.json

# Database tooling runs locally, never in the Vercel build
db/
scripts/

# Generated build state and local project metadata
tsconfig.tsbuildinfo
.next/
.vercel/
